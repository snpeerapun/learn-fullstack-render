# ก๊อปไฟล์นี้เป็น .env แล้วแก้ค่า
# ตัวอย่างต่อ Postgres ในเครื่อง:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learn_todo
# ตัวอย่างต่อ Postgres บน Render (External Database URL จาก dashboard):
# DATABASE_URL=postgres://learn_todo:xxxx@dpg-xxxx-a.singapore-postgres.render.com/learn_todo
PORT=3000
